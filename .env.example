# AI Trading Backend V8 配置示例
# 复制此文件为 .env 并填入实际配置
# 说明：当前后端通过 DB_TYPE + MYSQL_* / SQLITE_DB_PATH 组装数据库连接串，
# 不直接从环境变量读取 DATABASE_URL。

# ==================== 应用配置 ====================
APP_NAME="AI Trading Risk & Auto-Hedge System"

# 交易模式：OFF（关闭）/ DRY_RUN（模拟）/ REAL（实盘）
# 建议先使用 DRY_RUN 测试
TRADE_MODE=DRY_RUN

# ==================== 数据库与缓存配置 ====================
# 数据库类型: sqlite / mysql
# 注意：切换为 mysql 前请确保数据库已创建且用户有权限
DB_TYPE=mysql

# SQLite 配置（当 DB_TYPE=sqlite 时有效）
SQLITE_DB_PATH=./demo.db

# MySQL 配置（当 DB_TYPE=mysql 时有效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_trading
# 请在实际部署中不要在 .env.example 中写入真实密码
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=ai_trading

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ==================== Tiger 券商配置 ====================
# Tiger 账户号（模拟盘或真实账户）
# 示例：21272246230273657
TIGER_ACCOUNT=

# Tiger Open API 配置（使用官方 tigeropen SDK）
# 留空则使用 Dummy 客户端（测试模式，Greeks 和持仓均为 0）

# RSA 私钥文件路径（.pem 格式）
# 生成方法：openssl genrsa -out private_key.pem 1024
TIGER_PRIVATE_KEY_PATH=keys/private_key.pem

# 开发者 ID（从老虎开放平台获取）
# 获取地址：https://quant.itigerup.com/openapi/
TIGER_ID=

# 行情数据模式配置
# DELAYED: 免费延迟行情（约15-20分钟延迟）- 适合开发测试
# REALTIME: 实时行情（需付费订阅）- 生产环境必须
# 详细说明见：QUOTE_DATA_ANALYSIS.md
TIGER_QUOTE_MODE=DELAYED

# 是否在 API 响应中显示数据延迟警告
QUOTE_DATA_WARNING=true

# ==================== OpenAI 配置 ====================
# 用于 AI 决策助手（模型名以你的账号可用列表为准，服务端会做回退）
# 请不要在示例文件中放置真实密钥
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=30
OPENAI_API_BASE=

# ==================== DeepSeek 配置（AI 兜底方案） ====================
# DeepSeek API 完全兼容 OpenAI 格式，在 OpenAI 失败时自动切换
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_ENABLED=true
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90

# ==================== AI 策略配置 ====================
# 可用的 AI 提供商列表，按优先级排序（逗号分隔）
AI_PROVIDERS=openai,deepseek
# 优先使用的 AI 提供商
AI_PREFERRED_PROVIDER=openai

# ===== FRED API (Federal Reserve Economic Data) ======
# 用途: 获取宏观经济指标数据
FRED_API_KEY=

# ===== 数据缓存配置 =====
# 技术指标缓存时长（小时）
CACHE_TTL_TECHNICAL_HOURS=1
# 基本面数据缓存时长（小时）
CACHE_TTL_FUNDAMENTAL_HOURS=24
# 宏观指标缓存时长（小时）
CACHE_TTL_MACRO_HOURS=24
# 地缘政治事件缓存时长（小时）
CACHE_TTL_GEOPOLITICAL_HOURS=24

# ===== 定时任务配置 =====
# 是否启用定时任务
ENABLE_SCHEDULER=true
SCHEDULER_TECHNICAL_HOURS=1
SCHEDULER_FUNDAMENTAL_HOURS=24
SCHEDULER_MACRO_HOURS=24
SCHEDULER_GEOPOLITICAL_HOURS=24
SCHEDULER_RISK_HOURS=24

# ==================== 网络代理配置（可选） ====================
# 通过配置管理代理开关：启用后,服务启动时会设置 HTTP(S)_PROXY/NO_PROXY 环境变量，
# OpenAI（httpx）与 FRED（requests/fredapi）都会自动走代理。
PROXY_ENABLED=false
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ==================== 并发控制配置（中期优化） ====================
# 外部API并发上限（Tiger/FRED/News/Yahoo等）
EXTERNAL_API_CONCURRENCY=5
# 刷新任务并发上限（positions/refresh 等）
REFRESH_CONCURRENCY=5

# ==================== 风险预算配置 ====================
DEFAULT_RISK_BUDGET_USD=20000

# ==================== 外部 API 限流规避 ====================
# 触发限流后冷却时间（秒）
API_RATE_LIMIT_COOLDOWN_SECONDS=900

# ==================== 认证配置（默认启用） ====================
# 是否开启认证（默认 True）。在生产环境请通过环境变量覆盖默认用户名/密码。
AUTH_ENABLED=True
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# 用于签发 JWT token 的密钥，请在部署时设置为强随机值
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 策略执行/管理用户（逗号分隔）
STRATEGY_EXECUTE_USERS=admin
STRATEGY_MANAGE_USERS=admin
# 导出文件根目录
EXPORT_ROOT=./exports

# 新闻/数据 API Key（示例占位符）
NEWS_API_KEY=

# ==================== 数据库连接说明 ====================
# 1) SQLite：设置 DB_TYPE=sqlite，并填写 SQLITE_DB_PATH
# 2) MySQL：设置 DB_TYPE=mysql，并填写 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DB
# 3) 当前配置类会自动生成 DATABASE_URL，无需在 .env 中额外声明

# ==================== 线上部署配置 (Traefik / SSL) ====================
# 用于 Traefik SSL 证书申请的邮箱
ACME_EMAIL=your-email@example.com
# 服务的域名配置（仅在 deploy/docker-compose.yml + Traefik 场景需要）
FRONTEND_DOMAIN=localhost
BACKEND_DOMAIN=api.localhost

# ==================== V9: 交易安全与通知配置 ====================
# 订单模式：OFF / PAPER / REAL
ORDER_MODE=PAPER
# 单笔订单最大占净值比例
MAX_SINGLE_ORDER_PCT=0.2
# 日亏损熔断阈值
MAX_DAILY_LOSS_PCT=0.05
# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 权益快照定时（小时）
SCHEDULER_EQUITY_SNAPSHOT_HOURS=24
# 告警检查间隔（分钟）
SCHEDULER_ALERT_CHECK_MINUTES=5

# ==================== V10: AI 自主闭环配置 ====================
# AI 自主级别：FULL（全自主）/ SEMI（半自主）/ ADVISORY（仅建议）
AI_AUTONOMY_LEVEL=SEMI

# 允许交易的标的类型：STOCK / ALL
ALLOWED_ASSET_TYPES=STOCK

# 风险门边界（不可绕过）
MAX_SINGLE_POSITION_PCT=0.25
MAX_VAR_PCT=0.03
MAX_STRESS_LOSS_PCT=0.15
MAX_DAILY_TRADES=10
ALLOW_CLOSING_DURING_CIRCUIT_BREAKER=true
EXIT_ORDER_COOLDOWN_MINUTES=5
EXIT_ORDER_LOCK_SECONDS=30

# 半自主模式：撤单窗口（分钟）
REVOKE_WINDOW_MINUTES=30

# Paper Trading 配置
PAPER_INITIAL_CAPITAL=100000.0
PAPER_AUTO_GRADUATE=True

# DataHub 数据源优先级 (yfinance / tiger)
DATA_HUB_PRIMARY=yfinance
DATA_HUB_FALLBACK=tiger

# 期权分析缓存时间（小时）
OPTIONS_ANALYSIS_CACHE_EXPIRE_HOURS=24

# AI 模型路由
AI_LIGHTWEIGHT_MODEL=deepseek-chat
AI_COMPLEX_MODEL=deepseek-reasoner

# 回测配置
BACKTEST_MAX_CONCURRENT=3
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005

# 持仓监控 & 自动止损/止盈
POSITION_STOP_LOSS_PCT=0.05
POSITION_TAKE_PROFIT_PCT=0.15
POSITION_MONITOR_INTERVAL_MINUTES=15
# 超并发持仓主动降载扫描间隔（交易时段内生效）
POSITION_CAPACITY_GUARD_INTERVAL_MINUTES=15

# 券商订单状态自动对账（用于回写手动撤单/非活跃时段成交）
BROKER_ORDER_SYNC_INTERVAL_MINUTES=10
BROKER_ORDER_SYNC_LOOKBACK_DAYS=3

# AI 周报定时
SCHEDULER_WEEKLY_REPORT_DAY=mon
SCHEDULER_WEEKLY_REPORT_HOUR=8

# ==================== V10.2: 市场体制感知配置 ====================
# 是否启用市场体制分类
REGIME_ENABLED=true
# 体制「连续确认」天数：连续 N 天同一体制信号才切换
REGIME_CONFIRM_DAYS=3
# 各体制下的 VaR 门限倍数
# 格式："BULL_TREND:1.2,BEAR_TREND:0.8,HIGH_VOL:0.7,MEAN_REVERT:1.0,RANGE_BOUND:1.0,CRISIS:0.5"
REGIME_VAR_MULTIPLIERS=BULL_TREND:1.2,BEAR_TREND:0.8,HIGH_VOL:0.7,MEAN_REVERT:1.0,RANGE_BOUND:1.0,CRISIS:0.5
# 每日体制分类 Job 触发小时 (UTC)
REGIME_CLASSIFICATION_HOUR=8

# ==================== V10.3: 交易生命周期与态势配置 ====================

# 态势感知栏「围栏」统计窗口（向前展望天数）
# 默认 30：会统计未来 30 天内 requires_fence=true 且未 overridden 的事件
SA_FENCE_LOOKAHEAD_DAYS=30

# 宏观风险建议参数化（Risk-Off / Cautious）
# Risk-Off 场景下：风险资产仓位上限建议区间（相对常态）
# 例如 0.50~0.70 表示建议将风险资产仓位压到常态的 50%~70%
MACRO_RISK_OFF_POSITION_CAP_MIN=0.50
MACRO_RISK_OFF_POSITION_CAP_MAX=0.70

# Risk-Off 场景下：止损收紧比例（相对常态）
# 例如 0.20 表示建议较常态再收紧约 20%
MACRO_RISK_OFF_STOP_TIGHTEN_PCT=0.20

# Cautious 场景下：建议保留现金缓冲比例区间
MACRO_CAUTIOUS_CASH_BUFFER_MIN=0.10
MACRO_CAUTIOUS_CASH_BUFFER_MAX=0.20

# 生命周期看板 P50 基准倍数（用于延迟报警颜色渲染，后端逻辑参考）
# PIPELINE_P50_MULTIPLIER_YELLOW=1.5
# PIPELINE_P50_MULTIPLIER_RED=3.0

# 是否启用 AI 自动撤销/清理过时信号 (QUEUED rescue 机制)
ENABLE_QUEUED_SIGNAL_RESCUE=true
# 信号清理超时时间（分钟）
QUEUED_SIGNAL_RESCUE_MINUTES=3

# ==================== V10.4.2: 信号精英化漏斗配置 (Signal Quality) ====================
# 漏斗前缀为 SQ_ (由 SignalQualityConfig 定义)

# 置信度门槛 (0-100)
SQ_ELITE_SIGNAL_SCORE=98
SQ_ELITE_SIGNAL_FLOOR=90
SQ_ELITE_MIN_ALIGNED_DIMS=5
SQ_HIGH_QUALITY_SIGNAL_SCORE=95
SQ_MEDIUM_QUALITY_SIGNAL_SCORE=90
SQ_SIGNAL_CONFIDENCE_THRESHOLD=95
# 置信度校准下界最低要求 (0-100)
SQ_SIGNAL_CONFIDENCE_FLOOR=85
# 信号预期夏普比率下限
SQ_MIN_EXPECTED_SHARPE=0.5

# 最少同向维度数量（共振，1-6）
SQ_SIGNAL_RESONANCE_MIN_DIMS=4
# 是否强制要求技术面通过
SQ_RESONANCE_REQUIRED_TECHNICAL=true
# 是否启用反共振一票否决
SQ_ANTI_RESONANCE_KILL=true

# 最大并发持仓标的数（基础上限；在 HIGH_VOL / CRISIS 等体制下会自动进一步收紧）
SQ_MAX_CONCURRENT_POSITIONS=6
# 每个交易日最多推进信号数
SQ_MAX_DAILY_SIGNALS=5
# 与现有持仓最大相关性
SQ_MAX_POSITION_CORRELATION=0.70

# 最小日均成交量（美元）
SQ_MIN_ADV_THRESHOLD=1000000.0
# 最小市值（美元）
SQ_MIN_MARKET_CAP=500000000.0

# 幽灵交易：被拒信号的虚拟追踪天数
SQ_GHOST_TRADE_MAX_DAYS=10
# 是否启用幽灵交易追踪
SQ_GHOST_TRADE_ENABLED=true

# ==================== V10.5.1: AI 安全与透明度增强 (Live Safety) ====================
# 是否启用 AI 安全自动限流（降级/冻结）
AI_SAFETY_THROTTLING_ENABLED=true
# 市场数据陈旧度判定阈值（小时）
AI_SAFETY_STALE_QUOTE_HOURS=2.0
AI_SAFETY_CRITICAL_QUOTE_HOURS=6.0

# 策略评分卡：回看天数
SQ_SCORECARD_LOOKBACK_DAYS=90

# 执行策略引擎：默认滑点容忍度 (bps)
EXECUTION_SLIPPAGE_TOLERANCE_BPS=15


# ==================== V10.5.2: 席位竞争准入机制 (Capacity Replacement) ====================
# 是否启用席位竞争准入：满仓时不再直接硬拒新信号，而是与现有持仓统一排序竞争席位
SQ_CAPACITY_REPLACEMENT_ENABLED=true
# dry-run 观察模式：只记录仲裁结果，不实际生成替换平仓 / 不真正拒绝信号
SQ_CAPACITY_REPLACEMENT_DRY_RUN=false
# 单个决策周期最多触发几次席位替换，避免组合过度翻仓
SQ_CAPACITY_REPLACEMENT_MAX_PER_CYCLE=2
# 触发替换所需的最低优势分（挑战者 admission_score - 末位持仓 admission_score）
SQ_CAPACITY_REPLACEMENT_MIN_EDGE=5.0
# 新建持仓的最小保护持有时长（分钟）；保护期内不参与席位竞争
SQ_CAPACITY_MIN_HOLD_MINUTES=30
# 同一持仓被替换出后的冷却期（分钟）；冷却期内避免来回抖动
SQ_CAPACITY_REPLACEMENT_COOLDOWN_MINUTES=120

# 紧急绕过密钥（仅 SUPERADMIN 使用；一般保持为空）
SQ_QUALITY_GATE_BYPASS_KEY=

# ==================== V10.5.3: Profit Engine Upgrade Feature Flags ====================
# Observe 阶段建议仅开启 ALPHA_TRUTH_V2_ENABLED，其余先保持 false
ALPHA_TRUTH_V2_ENABLED=true
SEAT_VALUE_ARBITER_ENABLED=false
EXECUTION_POLICY_HARD_CONTROL_ENABLED=false
GOVERNANCE_HARD_GATE_ENABLED=false

# ==================== 配置说明 ====================
# 
# 1. Tiger Open API 配置步骤：
#    - 访问：https://quant.itigerup.com
#    - 注册并创建应用
#    - 生成 RSA 密钥对
#    - 上传公钥到平台
#    - 获取 tiger_id
#    - 将私钥路径和 tiger_id 填入上方
#
# 2. 交易模式说明：
#    - OFF：系统运行但不生成任何订单
#    - DRY_RUN：生成订单但仅打印，不实际发送（推荐测试用）
#    - REAL：真实下单到券商（谨慎使用！）
#
# 3. 使用 Dummy 客户端测试：
#    - 如果不配置 TIGER_PRIVATE_KEY_PATH 和 TIGER_ID
#    - 系统会使用模拟客户端，返回空持仓和 0 Greeks
#    - 适合开发和功能测试
